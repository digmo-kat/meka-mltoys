span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Rubber All-Terrain Tires</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Fast, Friendly Support</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Exclusively At ML Toys</span><span class=\"ft-ticker__dot\"></span>\n      <span class=\"ft-ticker__item\">Built Stronger. Lasts Longer.</span><span class=\"ft-ticker__dot\"></span>\n    </div>\n  </div>\n</div>\n<script>\n(function() {\n  function placeTicker() {\n    var ticker = document.getElementById('ft-ticker');\n    var tabs = document.querySelector('.pd-tabs');\n    if (!ticker || !tabs) return;\n    tabs.parentNode.insertBefore(ticker, tabs);\n    ticker.classList.add('ft-ticker--placed');\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', placeTicker);\n  } else {\n    placeTicker();\n  }\n})();\n</script>"
