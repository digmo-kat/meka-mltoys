      "blocks": {
        "faq_pU3RPR": {
          "type": "faq",
          "name": "How long does the battery",
          "settings": {
            "question": "How long does the battery last on a single charge?",
            "answer": "Stock 12V 12Ah battery delivers about 1.5 to 2 hours of mixed driving on flat surfaces. Upgraded ML Toys batteries can stretch that to 3+ hours."
          }
